{
  "name": "jevc",
  "version": "0.1.0",
  "description": "Compile natural-language instructions into Jev programs: narrow evidence questions for the model, the verdict computed in code.",
  "keywords": [
    "jev",
    "typesafe",
    "llm",
    "guardrails",
    "policy",
    "agents",
    "claude-code",
    "langchain",
    "ai-sdk"
  ],
  "license": "Apache-2.0",
  "author": "Doron Podoleanu <doron.podoleanu@gmail.com>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doronp/jevc.git"
  },
  "bugs": {
    "url": "https://github.com/doronp/jevc/issues"
  },
  "homepage": "https://github.com/doronp/jevc#readme",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.12.0",
      "onFail": "error"
    }
  },
  "bin": {
    "jevc": "./dist/cli.js"
  },
  "exports": {
    ".": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "fixtures",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.typecheck.json",
    "check:live": "node dist/cli.js check --live",
    "prepublishOnly": "npm run typecheck && npm run build && npm test",
    "gallery": "tsx scripts/gallery.ts"
  },
  "dependencies": {
    "@typesafe-ai/sdk": "^0.6.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^5.0.1"
  }
}
